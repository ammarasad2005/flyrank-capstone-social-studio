{
  "name": "flyrank-capstone-social-studio",
  "version": "2.0.0",
  "description": "Turn one blog post into a scheduled, idempotent, multi-platform social campaign. FlyRank backend capstone.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "worker": "node --import tsx src/worker.ts",
    "dev": "node --import tsx --watch src/server.ts",
    "seed": "node --import tsx src/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "social-media",
    "adapter-pattern",
    "idempotency",
    "scheduler",
    "express",
    "postgres",
    "typescript"
  ],
  "author": "Muhammad Ammar Asad",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "bullmq": "^6.3.10",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "pg": "^8.12.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
}
