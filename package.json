{
  "name": "flyrank-capstone-social-studio",
  "version": "2.0.0",
  "description": "Turn one blog post into a scheduled, idempotent, multi-platform social campaign. FlyRank backend capstone.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "worker": "node --import tsx src/worker.ts",
    "dev": "node --import tsx --watch src/server.ts",
    "seed": "node --import tsx src/seed.ts",
    "test": "NODE_ENV=test node --import tsx --test tests/*.test.ts",
    "test:postgres": "node --import tsx scripts/test-postgres-concurrency.ts",
    "test:bullmq": "node --import tsx scripts/test-bullmq-restart.ts",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "social-media",
    "adapter-pattern",
    "idempotency",
    "scheduler",
    "express",
    "postgres",
    "typescript"
  ],
  "author": "Muhammad Ammar Asad",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@sentry/node": "^11.1.0",
    "bullmq": "^6.3.10",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "tsx": "^4.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.11.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
