# ─────────────────────────────────────────────────────────────────────────────
# Social Media Studio — environment configuration
# Copy to `.env` and fill in. NEVER commit your real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000

# Database file (SQLite). Default is data/studio.db
DATABASE_PATH=data/studio.db

# Which platforms to generate variants for + which real adapter is live.
# Comma-separated adapter ids: mastodon, mock_x, mock_linkedin
PLATFORMS=mastodon,mock_x,mock_linkedin

# ── Mastodon (the one REAL free target) ──────────────────────────────────────
# Create a token at:  https://<your-instance>/settings/applications  ->
#   "New application" -> scopes: write:statuses (read optional) -> save ->
#   copy "Your access token".  A test account on any open instance works.
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your-mastodon-access-token-here
# Post visibility for published statuses: public | unlisted | private | direct
MASTODON_VISIBILITY=unlisted

# ── Adapter swap (PROBE 6) ───────────────────────────────────────────────────
# Reroute a platform to a different adapter with ZERO code change. Comma-separated
# from=to pairs. Example: publish "mastodon" campaigns through the X mock instead:
#   ADAPTER_OVERRIDE=mastodon=mock_x
ADAPTER_OVERRIDE=

# ── AI variant text (OPTIONAL) ───────────────────────────────────────────────
# Enforcement is graded, not generation. Leave USE_AI=false to use deterministic
# templates (the app runs with zero AI setup). Set true + a key to use Gemini.
USE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Scheduler
# How often (ms) the durable worker scans for due slots.
SCHEDULER_TICK_MS=2000
# Set to "false" to NOT auto-start the worker inside the web process
# (useful when running the worker as a separate process).
SCHEDULER_ENABLED=true
