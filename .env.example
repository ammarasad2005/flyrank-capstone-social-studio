# ─────────────────────────────────────────────────────────────────────────────
# Social Media Studio — environment configuration
# Copy to `.env` and fill in. NEVER commit your real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Production: set DATABASE_URL to a Postgres connection string (Neon/Supabase/RDS).
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
# Local/dev/demo: leave DATABASE_URL unset to use in-process PGlite at DATABASE_PATH.
DATABASE_PATH=data/pg
# DATABASE_URL=

# Which platforms to generate variants for.
# Comma-separated adapter ids: telegram, mastodon, mock_x, mock_linkedin
PLATFORMS=telegram,mock_x,mock_linkedin

# ── Telegram (the one REAL free target) ──────────────────────────────────────
# In the Telegram app: message @BotFather -> /newbot -> copy the bot token.
# Create a channel, add the bot as an admin, and put the channel id (e.g. @mychannel
# or a numeric -100... id) below. A public @channel gives published messages a real link.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=@your_channel_or_numeric_id
# Optional message formatting: leave blank, or "HTML" / "MarkdownV2"
TELEGRAM_PARSE_MODE=

# ── Mastodon (a SECOND real target, optional) ────────────────────────────────
# Create a token at:  https://<your-instance>/settings/applications  ->
#   "New application" -> scope write:statuses -> copy "Your access token".
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
# Post visibility for published statuses: public | unlisted | private | direct
MASTODON_VISIBILITY=unlisted

# ── Adapter swap (PROBE 6) ───────────────────────────────────────────────────
# Reroute a platform to a different adapter with ZERO code change. Comma-separated
# from=to pairs. Example: publish "mastodon" campaigns through the X mock instead:
#   ADAPTER_OVERRIDE=mastodon=mock_x
ADAPTER_OVERRIDE=

# ── AI variant text (OPTIONAL) ───────────────────────────────────────────────
# Enforcement is graded, not generation. Leave USE_AI=false to use deterministic
# templates (the app runs with zero AI setup). Set true + a key to use Gemini.
USE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Scheduler
# How often (ms) the durable worker scans for due slots.
SCHEDULER_TICK_MS=2000
# Set to "false" to NOT auto-start the worker inside the web process
# (useful when running the worker as a separate process).
SCHEDULER_ENABLED=true

# ── Queue engine (Sprint 2) ──────────────────────────────────────────────────
# inprocess : a DB-backed poller (no broker). Default; multi-worker-safe via
#             FOR UPDATE SKIP LOCKED. Runs and is fully tested anywhere.
# bull      : BullMQ over Redis (Upstash) for a horizontally-scaled worker fleet.
#             Requires REDIS_URL (a rediss://… TCP endpoint — the Upstash REST
#             URL/token will NOT work with BullMQ/ioredis). Run the worker via
#             `npm run worker`; the web process then only serves HTTP.
QUEUE_DRIVER=inprocess
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ── Retry / backoff / dead-letter (Sprint 2) ─────────────────────────────────
# A failed publish is retried with exponential backoff + jitter. After
# RETRY_MAX_ATTEMPTS failures the slot moves to 'dead_letter' and an alert fires.
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_MS=5000
# Optional: POST a JSON {text,...} alert here when a slot is dead-lettered
# (Slack/Discord incoming-webhook style). Leave blank to only log.
ALERT_WEBHOOK_URL=
